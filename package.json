{
  "name": "ideliveryfood",
  "version": "0.1.0",
  "private": true,
  "description": "iDeliveryFood — Multi-tenant Food Delivery Marketplace Monorepo (Phase A: M00-M03)",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "node scripts/secret-scan.mjs && pnpm -r lint",
    "test": "pnpm -r test",
    "db:reset:local": "node scripts/db-reset-local.mjs",
    "db:migrate": "node scripts/db-apply-migrations.mjs",
    "bootstrap:first-admin": "node scripts/bootstrap-first-admin.mjs",
    "security:scan": "node scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "pg": "^8.13.3",
    "typescript": "^5.8.2"
  }
}
