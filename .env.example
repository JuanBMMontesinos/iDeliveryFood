# ============================================================================
# iDeliveryFood — Root Environment Template (.env.example)
# ============================================================================
# SECURITY RULE: Never commit real secrets, tokens, or .env files to Git.
# Client bundles (NEXT_PUBLIC_*) may ONLY receive public URLs and publishable keys.
# ============================================================================

# 1. Runtime & Operational Defaults
NODE_ENV=development
APP_ENV=development
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,pt-BR
OPERATIONAL_TIMEZONE=America/Sao_Paulo
CURRENCY_CODE=BRL
API_PORT=4000
API_BASE_URL=http://localhost:4000/v1

# 2. Supabase Configuration (Project: dwsoochnfxldfvcaijie)
NEXT_PUBLIC_SUPABASE_URL=https://dwsoochnfxldfvcaijie.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_publishable_key
SUPABASE_URL=https://dwsoochnfxldfvcaijie.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_publishable_key
# SERVER-ONLY SECRET — NEVER EXPOSE TO NEXT_PUBLIC_* OR MOBILE APPS
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
SUPABASE_JWT_SECRET=replace_with_server_only_jwt_secret
DATABASE_URL=postgresql://postgres:replace_with_db_password@db.dwsoochnfxldfvcaijie.supabase.co:5432/postgres

# 3. Pre-Configured Payment Service Providers (PSP — Option 2 Adapter Structure)
PRIMARY_PSP_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_SECRET=
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=

# 4. Pre-Configured Maps & Geocoding Providers
PRIMARY_MAPS_PROVIDER=google_maps
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_WEB_KEY=

MAPBOX_SECRET_TOKEN=
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# 5. Pre-Configured Transactional Messaging & Push Providers
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@ideliveryfood.invalid

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.ideliveryfood.app
