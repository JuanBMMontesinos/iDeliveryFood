      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Store Menu & Options" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Cardápio e Complementos da Loja" } }
      }
    },
    "store_detail_required_options": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Required option group" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Grupo de opções obrigatório" } }
      }
    },
    "cart_title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Your Basket" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Sua Sacola" } }
