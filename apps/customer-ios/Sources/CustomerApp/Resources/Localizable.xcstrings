      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Search restaurants or dishes" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Buscar restaurantes ou pratos" } }
      }
    },
    "addresses_title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "My Delivery Addresses" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Meus Endereços de Entrega" } }
      }
    },
    "addresses_gps_fallback_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Location permission denied or unavailable. Enter your delivery address manually below." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Permissão de localização negada ou indisponível. Informe seu endereço manualmente abaixo." } }
      }
    },
