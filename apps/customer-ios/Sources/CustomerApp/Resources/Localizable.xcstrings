      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Available Restaurants" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Restaurantes Disponíveis" } }
      }
