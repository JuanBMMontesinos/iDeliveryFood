{
  "name": "@ideliveryfood/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "dependencies": {
    "@ideliveryfood/authz": "workspace:*",
    "@ideliveryfood/config": "workspace:*",
    "@ideliveryfood/contracts": "workspace:*",
    "@ideliveryfood/domain": "workspace:*",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11"
  },
  "scripts": {
    "start": "node dist/src/main.js",
